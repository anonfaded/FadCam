# Server-side platform services only. These values are NOT used by the Android build.
TZ=UTC

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-this-before-starting

MINIO_ROOT_USER=fadcam
MINIO_ROOT_PASSWORD=change-this-before-starting

KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=change-this-before-starting
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=change-this-before-starting

# Optional public edge for the existing FadCam Remote / Server Room live stream.
# SERVER_ROOM_URL must be reachable from the gateway host.
# PUBLIC_HOSTNAME must resolve publicly to the gateway and ports 80/443 must be reachable.
PUBLIC_HOSTNAME=stream.example.com
SERVER_ROOM_URL=http://192.168.1.100:8080
