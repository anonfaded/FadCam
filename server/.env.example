# Server-side platform services only. These values are NOT used by the Android build.
TZ=UTC

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-this-before-starting

MINIO_ROOT_USER=fadcam
MINIO_ROOT_PASSWORD=change-this-before-starting

KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=change-this-before-starting
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=change-this-before-starting

# Public edge for the existing FadCam Remote / Server Room live stream.
# Leave PUBLIC_HOSTNAME at :80 for automatic public-IP HTTP exposure.
# Set a real DNS hostname instead to let Caddy manage HTTPS automatically.
PUBLIC_HOSTNAME=:80

# Optional discovery tuning. No phone IP/port is required.
SERVER_ROOM_PORT_START=8080
SERVER_ROOM_PORT_END=8089
DISCOVERY_INTERVAL_SECONDS=10
DISCOVERY_TIMEOUT_SECONDS=0.5
# DISCOVERY_SUBNETS=192.168.1.0/24
