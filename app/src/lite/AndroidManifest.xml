<?xml version="1.0" encoding="utf-8"?>
<!-- Lite flavor manifest: removes Full-only components declared in the shared
     manifest (main manifest still supplies all permissions/activities/services). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Screen recording (FadRec) permissions not needed in Lite -->
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE"
        tools:node="remove" />

    <application>
        <!-- Lite keeps only the useful disguise identities (Notes/Calculator/Weather/Clock);
             exotic launcher aliases + their icon sets are dropped from Lite -->
        <activity-alias
            android:name=".MainActivity.AlternativeIcon"
            tools:node="remove" />
        <activity-alias
            android:name=".MainActivity.FadedIcon"
            tools:node="remove" />
        <activity-alias
            android:name=".MainActivity.PalestineIcon"
            tools:node="remove" />
        <activity-alias
            android:name=".MainActivity.PakistanIcon"
            tools:node="remove" />
        <activity-alias
            android:name=".MainActivity.FadSecLabIcon"
            tools:node="remove" />
        <activity-alias
            android:name=".MainActivity.NooristicIcon"
            tools:node="remove" />
        <activity-alias
            android:name=".MainActivity.BatIcon"
            tools:node="remove" />
        <activity-alias
            android:name=".MainActivity.RedBinaryIcon"
            tools:node="remove" />
        <activity-alias
            android:name=".MainActivity.FootballIcon"
            tools:node="remove" />
        <activity-alias
            android:name=".MainActivity.CarIcon"
            tools:node="remove" />
        <activity-alias
            android:name=".MainActivity.JetIcon"
            tools:node="remove" />
        <activity-alias
            android:name=".MainActivity.MinimalIcon"
            tools:node="remove" />
        <activity-alias
            android:name=".MainActivity.BlackIcon"
            tools:node="remove" />
        <activity
            android:name="com.fadcam.ui.faditor.FaditorEditorActivity"
            tools:node="remove" />
        <service
            android:name="com.fadcam.ui.faditor.export.ExportService"
            tools:node="remove" />
        <!-- Remote/streaming is Full-only: never run these services in Lite -->
        <service
            android:name="com.fadcam.streaming.RemoteStreamService"
            tools:node="remove" />
        <service
            android:name="com.fadcam.services.AlarmService"
            tools:node="remove" />
        <!-- Screen recording (FadRec) is Full-only -->
        <activity
            android:name="com.fadcam.fadrec.ui.overlay.TextEditorActivity"
            tools:node="remove" />
        <activity
            android:name="com.fadcam.fadrec.ui.TransparentPermissionActivity"
            tools:node="remove" />
        <service
            android:name="com.fadcam.fadrec.services.ScreenRecordingService"
            tools:node="remove" />
        <service
            android:name="com.fadcam.fadrec.ui.FloatingControlsService"
            tools:node="remove" />
        <service
            android:name="com.fadcam.fadrec.ui.AnnotationService"
            tools:node="remove" />
        <activity
            android:name="com.fadcam.fadrec.ui.ColorPickerDialogActivity"
            tools:node="remove" />
        <activity
            android:name="com.fadcam.fadrec.ui.ProjectNamingDialogActivity"
            tools:node="remove" />
        <activity
            android:name="com.fadcam.fadrec.ui.ProjectSelectionDialogActivity"
            tools:node="remove" />
    </application>
</manifest>
