<?xml version="1.0" encoding="utf-8"?>
<!--
  Public-release permission hardening.

  The release variant deliberately removes high-risk/special-access capabilities
  that are not required for the core camera/recording experience. Engineering and
  experimental builds may retain these capabilities for feature development, but
  the public release must use the least-privilege manifest possible.

  Core release functionality remains camera + microphone recording, playback,
  MediaStore/SAF-backed media handling, and the declared foreground services.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Broad/all-files storage is not required by the public release. -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.WRITE_MEDIA_VIDEO"
        tools:node="remove" />

    <!-- Do not request battery-optimization exemption in the public release. -->
    <uses-permission
        android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"
        tools:node="remove" />

    <!-- SYSTEM_ALERT_WINDOW is not required by the public release. -->
    <uses-permission
        android:name="android.permission.SYSTEM_ALERT_WINDOW"
        tools:node="remove" />

    <!-- Remove the experimental accessibility screenshot service from release. -->
    <application
        android:requestLegacyExternalStorage="false"
        tools:replace="android:requestLegacyExternalStorage">
        <service
            android:name=".service.FadRecScreenshotAccessibilityService"
            tools:node="remove" />
    </application>
</manifest>
