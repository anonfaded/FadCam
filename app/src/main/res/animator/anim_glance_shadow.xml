<set xmlns:android="http://schemas.android.com/apk/res/android" android:ordering="sequentially">
    <set android:ordering="together">
        <objectAnimator android:propertyName="translateX"
            android:valueFrom="0" android:valueTo="-6"
            android:duration="340" android:interpolator="@android:interpolator/decelerate_cubic" />
        <objectAnimator android:propertyName="translateY"
            android:valueFrom="0" android:valueTo="2"
            android:duration="340" android:interpolator="@android:interpolator/decelerate_cubic" />
    </set>
    <set android:ordering="together">
        <objectAnimator android:propertyName="translateX"
            android:valueFrom="-6" android:valueTo="-6" android:duration="600" />
        <objectAnimator android:propertyName="translateY"
            android:valueFrom="2" android:valueTo="2" android:duration="600" />
    </set>
    <set android:ordering="together">
        <objectAnimator android:propertyName="translateX"
            android:valueFrom="-6" android:valueTo="0"
            android:duration="340" android:interpolator="@android:interpolator/decelerate_cubic" />
        <objectAnimator android:propertyName="translateY"
            android:valueFrom="2" android:valueTo="0"
            android:duration="340" android:interpolator="@android:interpolator/decelerate_cubic" />
    </set>
</set>
