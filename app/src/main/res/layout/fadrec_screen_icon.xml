<?xml version="1.0" encoding="utf-8"?>
<!-- Default fallback for the FadRec screen recording preview. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_gravity="center">

    <ImageView
        android:id="@+id/ivBubbleBackground"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:layout_gravity="center"
        android:src="@drawable/bubble_shape"
        android:tint="?attr/colorHeading"
        android:alpha="0.15"
        android:scaleType="fitCenter"
        android:contentDescription="Bubble background shape" />

    <ImageView
        android:id="@+id/ivScreenRecordingIcon"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_gravity="center"
        android:src="@drawable/screen_recorder"
        android:tint="?attr/colorHeading"
        android:alpha="0.3"
        android:scaleType="fitCenter"
        android:contentDescription="Screen recording icon" />

</FrameLayout>
