<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <!-- Fixed Header: back + title + master switch -->
    <LinearLayout
        android:id="@+id/header_bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="12dp"
        android:background="@drawable/header_bar_rounded_bg"
        android:elevation="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <ImageView
            android:id="@+id/back_button"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:padding="2dp"
            android:src="@drawable/ic_close"
            android:contentDescription="@string/watch_back_desc"
            android:tint="@android:color/white"/>
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/settings_haptics_title"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginStart="12dp"
            android:textColor="@android:color/white"
            android:textAlignment="viewStart"/>
        <com.fadcam.ui.AvatarToggleView
            android:id="@+id/toggle_haptics_master"
            android:layout_width="52dp"
            android:layout_height="52dp"/>
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/content_scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:paddingBottom="40dp"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/header_bar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="16dp">

            <!-- No-vibrator banner: shown only when the device lacks a motor -->
            <LinearLayout
                android:id="@+id/haptics_no_vibrator_banner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/picker_banner_bg"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:layout_marginBottom="8dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="10dp"
                    android:fontFamily="@font/materialicons"
                    android:gravity="center"
                    android:text="vibration_off"
                    android:textSize="18sp"
                    android:textColor="#FFC107" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/settings_haptics_no_vibrator"
                    android:textColor="#E8A33D"
                    android:textSize="13sp"
                    android:lineSpacingExtra="2dp"
                    android:textAlignment="viewStart" />
            </LinearLayout>

            <!-- Recording events section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="8dp"
                android:text="@string/settings_haptics_section_recording"
                android:textColor="?attr/sectionHeaderColor"
                android:textStyle="bold" />

            <!-- Recording events card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/settings_group_card_bg">

                <!-- Start vibration: tap to choose strength -->
                <LinearLayout
                    android:id="@+id/row_haptics_start"
                    style="@style/SettingsGroupRow"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginEnd="16dp"
                        android:src="@drawable/ic_play_arrow_24"
                        android:tint="@android:color/darker_gray"/>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/settings_haptics_start_title"
                            android:textStyle="bold"
                            android:textSize="15sp"
                            android:textColor="?attr/colorHeading"
                            android:textAlignment="viewStart"/>
                        <TextView
                            android:id="@+id/start_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@android:color/darker_gray"
                            android:textSize="12sp"
                            android:textAlignment="viewStart"/>
                    </LinearLayout>
                    <ImageView
                        android:id="@+id/btn_preview_start"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:padding="6dp"
                        android:src="@drawable/ic_play_arrow_24"
                        android:tint="@android:color/darker_gray"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/settings_haptics_start_title"
                        android:clickable="true"
                        android:focusable="true"/>
                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginStart="4dp"
                        android:src="@drawable/ic_arrow_right"
                        android:tint="@android:color/darker_gray"/>
                </LinearLayout>

                <View style="@style/SettingsDivider" />

                <!-- Stop vibration: tap to choose strength -->
                <LinearLayout
                    android:id="@+id/row_haptics_stop"
                    style="@style/SettingsGroupRow"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginEnd="16dp"
                        android:src="@drawable/ic_stop"
                        android:tint="@android:color/darker_gray"/>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/settings_haptics_stop_title"
                            android:textStyle="bold"
                            android:textSize="15sp"
                            android:textColor="?attr/colorHeading"
                            android:textAlignment="viewStart"/>
                        <TextView
                            android:id="@+id/stop_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@android:color/darker_gray"
                            android:textSize="12sp"
                            android:textAlignment="viewStart"/>
                    </LinearLayout>
                    <ImageView
                        android:id="@+id/btn_preview_stop"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:padding="6dp"
                        android:src="@drawable/ic_play_arrow_24"
                        android:tint="@android:color/darker_gray"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/settings_haptics_stop_title"
                        android:clickable="true"
                        android:focusable="true"/>
                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginStart="4dp"
                        android:src="@drawable/ic_arrow_right"
                        android:tint="@android:color/darker_gray"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Interface feedback section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp"
                android:text="@string/settings_haptics_section_interface"
                android:textColor="?attr/sectionHeaderColor"
                android:textStyle="bold" />

            <!-- UI feedback card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:orientation="vertical"
                android:background="@drawable/settings_group_card_bg">

                <LinearLayout
                    android:id="@+id/row_haptics_ui"
                    style="@style/SettingsGroupRow"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">
                    <TextView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginEnd="16dp"
                        android:fontFamily="@font/materialicons"
                        android:gravity="center"
                        android:text="vibration"
                        android:textColor="@android:color/darker_gray"
                        android:textSize="22sp"/>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/settings_haptics_ui_title"
                            android:textStyle="bold"
                            android:textSize="15sp"
                            android:textColor="?attr/colorHeading"
                            android:textAlignment="viewStart"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/settings_haptics_ui_subtitle"
                            android:textColor="@android:color/darker_gray"
                            android:textSize="12sp"
                            android:textAlignment="viewStart"/>
                    </LinearLayout>
                    <com.fadcam.ui.AvatarToggleView
                        android:id="@+id/toggle_haptics_ui"
                        android:layout_width="52dp"
                        android:layout_height="52dp"/>
                </LinearLayout>

                <View style="@style/SettingsDivider" />

                <LinearLayout
                    android:id="@+id/row_haptics_torch"
                    style="@style/SettingsGroupRow"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">
                    <TextView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginEnd="16dp"
                        android:fontFamily="@font/materialicons"
                        android:gravity="center"
                        android:text="flashlight_on"
                        android:textColor="@android:color/darker_gray"
                        android:textSize="22sp"/>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/settings_haptics_torch_title"
                            android:textStyle="bold"
                            android:textSize="15sp"
                            android:textColor="?attr/colorHeading"
                            android:textAlignment="viewStart"/>
                        <TextView
                            android:id="@+id/torch_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@android:color/darker_gray"
                            android:textSize="12sp"
                            android:textAlignment="viewStart"/>
                    </LinearLayout>
                    <ImageView
                        android:id="@+id/btn_preview_torch"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:padding="6dp"
                        android:src="@drawable/ic_play_arrow_24"
                        android:tint="@android:color/darker_gray"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/settings_haptics_torch_title"
                        android:clickable="true"
                        android:focusable="true"/>
                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginStart="4dp"
                        android:src="@drawable/ic_arrow_right"
                        android:tint="@android:color/darker_gray"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/row_haptics_picker"
                    style="@style/SettingsGroupRow"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginEnd="16dp"
                        android:src="@drawable/ic_schedule"
                        android:tint="@android:color/darker_gray"/>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/settings_haptics_picker_title"
                            android:textStyle="bold"
                            android:textSize="15sp"
                            android:textColor="?attr/colorHeading"
                            android:textAlignment="viewStart"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/settings_haptics_picker_subtitle"
                            android:textColor="@android:color/darker_gray"
                            android:textSize="12sp"
                            android:textAlignment="viewStart"/>
                    </LinearLayout>
                    <com.fadcam.ui.AvatarToggleView
                        android:id="@+id/toggle_haptics_picker"
                        android:layout_width="52dp"
                        android:layout_height="52dp"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Reset to defaults -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical"
                android:background="@drawable/settings_group_card_bg">

                <LinearLayout
                    android:id="@+id/row_haptics_reset"
                    style="@style/SettingsGroupRow"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginEnd="16dp"
                        android:src="@drawable/undo_24px"
                        android:tint="@android:color/darker_gray"/>
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/settings_haptics_reset"
                        android:textStyle="bold"
                        android:textSize="15sp"
                        android:textColor="?attr/colorHeading"
                        android:textAlignment="viewStart"/>
                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/ic_arrow_right"
                        android:tint="@android:color/darker_gray"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Footer: explains defaults, no guessing -->
            <TextView
                android:id="@+id/haptics_footer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:text="@string/settings_haptics_footer"
                android:textColor="@android:color/darker_gray"
                android:textSize="11sp"
                android:textAlignment="viewStart"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
