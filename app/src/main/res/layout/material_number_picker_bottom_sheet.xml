<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="14dp"
    android:background="@drawable/picker_bottom_sheet_gradient_bg_dynamic">

    <!-- Drag handle — full-width touch strip (the ONLY draggable area):
         drag up expands the sheet, drag down dismisses. The pill is visual. -->
    <FrameLayout
        android:id="@+id/picker_drag_handle"
        android:layout_width="match_parent"
        android:layout_height="32dp">

        <View
            android:layout_width="44dp"
            android:layout_height="6dp"
            android:layout_gravity="center"
            android:background="@drawable/bottom_sheet_handle_bg"/>
    </FrameLayout>

    <!-- Header: close button + left-aligned title (consistent with every sheet) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="2dp"
        android:paddingEnd="2dp"
        android:paddingBottom="6dp">

        <ImageView
            android:id="@+id/picker_close_btn"
            android:layout_width="31dp"
            android:layout_height="31dp"
            android:padding="8dp"
            android:src="@drawable/ic_close"
            android:scaleType="centerInside"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:tint="?attr/pickerTextSecondary"
            android:contentDescription="@string/close"/>

        <TextView
            android:id="@+id/picker_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textStyle="bold"
            android:textSize="20sp"
            android:gravity="start"
            android:textColor="?attr/colorHeading"
            android:text="Title"/>
    </LinearLayout>

    <com.google.android.material.divider.MaterialDivider
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        app:dividerColor="#26FFFFFF"
        app:dividerInsetStart="0dp"
        app:dividerInsetEnd="0dp"/>

    <!-- ── TIME mode: wheels ─────────────────────────────────────────────
         Row 1 holds the three wheels with ":" separators centered against
         the wheel column height. Row 2 mirrors the same column layout so
         the labels stay perfectly centered; each per-column reset (undo)
         icon is overlaid on the start edge and never shifts the label. -->
    <LinearLayout
        android:id="@+id/picker_time_wheel_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="?attr/homeRailCardSurface"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeColor="?attr/homeRailCardBorder"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="2dp"
                android:paddingBottom="4dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp">

                <!-- Row 1: wheels with ":" separators. The center cell is drawn
                     INSIDE each wheel (background band): digits scroll through
                     it and the selected value always sits in the highlighted
                     cell. Tapping the center row opens the type-in dialog. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <NumberPicker
                        android:id="@+id/np_duration_hours"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=":"
                        android:textSize="28sp"
                        android:textStyle="bold"
                        android:includeFontPadding="false"
                        android:textColor="?attr/colorHeading"/>

                    <NumberPicker
                        android:id="@+id/np_duration_minutes"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=":"
                        android:textSize="28sp"
                        android:textStyle="bold"
                        android:includeFontPadding="false"
                        android:textColor="?attr/colorHeading"/>

                    <NumberPicker
                        android:id="@+id/np_duration_seconds"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"/>
                </LinearLayout>

                <!-- Row 2: labels + overlaid per-column reset icons -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginTop="-6dp">

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="@string/duration_picker_hours"
                            android:textSize="12sp"
                            android:textColor="?attr/homeRailTextSecondary"
                            android:textStyle="bold"/>
                        <ImageView
                            android:id="@+id/btn_reset_hours"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="start|center_vertical"
                            android:src="@drawable/undo_24px"
                            app:tint="?attr/pickerIconTint"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:padding="3dp"
                            android:contentDescription="@string/duration_picker_reset_hours"
                            android:visibility="invisible"/>
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=":"
                        android:textSize="28sp"
                        android:textStyle="bold"
                        android:includeFontPadding="false"
                        android:visibility="invisible"/>

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="@string/duration_picker_minutes"
                            android:textSize="12sp"
                            android:textColor="?attr/homeRailTextSecondary"
                            android:textStyle="bold"/>
                        <ImageView
                            android:id="@+id/btn_reset_minutes"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="start|center_vertical"
                            android:src="@drawable/undo_24px"
                            app:tint="?attr/pickerIconTint"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:padding="3dp"
                            android:contentDescription="@string/duration_picker_reset_minutes"
                            android:visibility="invisible"/>
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=":"
                        android:textSize="28sp"
                        android:textStyle="bold"
                        android:includeFontPadding="false"
                        android:visibility="invisible"/>

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="@string/duration_picker_seconds"
                            android:textSize="12sp"
                            android:textColor="?attr/homeRailTextSecondary"
                            android:textStyle="bold"/>
                        <ImageView
                            android:id="@+id/btn_reset_seconds"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="start|center_vertical"
                            android:src="@drawable/undo_24px"
                            app:tint="?attr/pickerIconTint"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:padding="3dp"
                            android:contentDescription="@string/duration_picker_reset_seconds"
                            android:visibility="invisible"/>
                    </FrameLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <!-- ── INT mode: single wheel in the same card container ───────────── -->
    <LinearLayout
        android:id="@+id/picker_int_wheel_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="?attr/homeRailCardSurface"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeColor="?attr/homeRailCardBorder"
            app:strokeWidth="1dp">

            <NumberPicker
                android:id="@+id/np_picker_single"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <!-- ── MB/GB mode: two wheels side by side (video split size) ─────── -->
    <LinearLayout
        android:id="@+id/picker_mbgb_wheel_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="?attr/homeRailCardSurface"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeColor="?attr/homeRailCardBorder"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="2dp"
                android:paddingBottom="4dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <NumberPicker
                        android:id="@+id/np_gb"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"/>

                    <NumberPicker
                        android:id="@+id/np_mb"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginTop="-6dp">

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center">
                        <TextView
                            android:id="@+id/np_label_value2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="@string/video_split_unit_gb"
                            android:textSize="12sp"
                            android:textColor="?attr/homeRailTextSecondary"
                            android:textStyle="bold"/>
                    </FrameLayout>

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center">
                        <TextView
                            android:id="@+id/np_label_value1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="@string/video_split_unit_mb"
                            android:textSize="12sp"
                            android:textColor="?attr/homeRailTextSecondary"
                            android:textStyle="bold"/>
                    </FrameLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <!-- Summary card (shared by both modes): what's selected + interaction hint -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/picker_summary_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        app:cardBackgroundColor="?attr/homeRailCardSurface"
        app:cardCornerRadius="14dp"
        app:cardElevation="0dp"
        app:strokeColor="?attr/homeRailCardBorder"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <TextView
                android:id="@+id/picker_summary_caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/duration_picker_selected_caption"
                android:textSize="12sp"
                android:textColor="?attr/homeRailTextSecondary"
                android:visibility="gone"/>

            <TextView
                android:id="@+id/picker_summary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textSize="30sp"
                android:textStyle="bold"
                android:textColor="?attr/colorHeading"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.02"/>

            <TextView
                android:id="@+id/picker_time_helper"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/duration_picker_helper_hint"
                android:textSize="12sp"
                android:textColor="?attr/homeRailTextSecondary"
                android:visibility="gone"/>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Validation / helper line -->
    <TextView
        android:id="@+id/picker_helper"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textSize="12sp"
        android:paddingTop="6dp"
        android:paddingBottom="0dp"/>

    <!-- Optional footer (timer info) -->
    <TextView
        android:id="@+id/picker_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="start"
        android:textSize="11sp"
        android:textColor="?attr/homeRailTextSecondary"
        android:paddingTop="2dp"
        android:paddingBottom="4dp"
        android:layout_marginTop="12dp"
        android:visibility="gone"/>

    <!-- Responsive actions: right-aligned flow — buttons share one line when
         they fit and wrap onto extra lines on narrow/zoomed screens instead
         of overflowing the window. GONE buttons are skipped by Flow. -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="10dp">

        <androidx.constraintlayout.helper.widget.Flow
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:constraint_referenced_ids="btn_picker_preview,btn_picker_reset,btn_picker_cancel,btn_picker_ok"
            app:flow_wrapMode="aligned"
            app:flow_horizontalAlign="end"
            app:flow_verticalAlign="center"
            app:flow_horizontalGap="10dp"
            app:flow_verticalGap="8dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_picker_preview"
            style="@style/PickerCancelButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:icon="@drawable/ic_play_arrow_24"
            app:iconGravity="textStart"
            app:iconTint="?attr/pickerIconTint"
            android:text="@string/duration_picker_preview"
            android:visibility="gone"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_picker_reset"
            style="@style/PickerCancelButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:icon="@drawable/undo_24px"
            app:iconGravity="textStart"
            app:iconTint="?attr/pickerIconTint"
            android:text="@string/universal_reset"
            android:visibility="gone"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_picker_cancel"
            style="@style/PickerCancelButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/duration_picker_cancel"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_picker_ok"
            style="@style/PickerActionButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/duration_picker_ok"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
