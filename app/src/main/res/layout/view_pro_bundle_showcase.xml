<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/showcaseRoot"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_pro_showcase"
    android:clipChildren="false" android:clipToPadding="false"
    android:padding="@dimen/pro_showcase_pad"
    android:layout_gravity="center">

    <LinearLayout android:id="@+id/showcaseRow"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:baselineAligned="false"
        android:clipChildren="false" android:clipToPadding="false">

        <LinearLayout android:id="@+id/showcaseTextColumn"
            android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:orientation="vertical">

            <TextView android:id="@+id/showcaseLabel"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:background="@drawable/bg_pro_showcase_badge"
                android:paddingHorizontal="@dimen/pro_showcase_badge_pad_h"
                android:paddingVertical="@dimen/pro_showcase_badge_pad_v"
                android:text="@string/pro_showcase_label"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/pro_card_champagne"
                android:textSize="@dimen/pro_showcase_label_size"
                android:letterSpacing="0.14" />

            <!-- The card's focal point: confident, warm white, generous line spacing. -->
            <TextView android:id="@+id/showcaseTitle"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/pro_showcase_title_margin"
                android:text="@string/pro_screen_bundle"
                android:fontFamily="sans-serif" android:textStyle="bold"
                android:lineSpacingExtra="2dp" android:maxLines="3"
                android:textColor="@color/pro_text" android:textSize="@dimen/pro_showcase_title_size" />

            <TextView android:id="@+id/showcaseSubtitle" android:visibility="gone"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/pro_showcase_supporting" android:textColor="@color/pro_text_secondary"
                android:textSize="@dimen/pro_showcase_body_size" />
            <TextView android:id="@+id/showcaseMeta" android:visibility="gone"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/pro_showcase_meta" android:textColor="@color/pro_text_secondary"
                android:textSize="@dimen/pro_showcase_meta_size" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/pro_showcase_chips_margin" android:orientation="vertical">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical">
                    <ImageView style="@style/ProShowcaseFeatureIcon"
                        android:src="@drawable/ic_pro_feature_apps" />
                    <TextView style="@style/ProShowcaseFeatureLabel"
                        android:layout_marginStart="@dimen/pro_showcase_feature_gap"
                        android:text="@string/pro_showcase_chip_installs" />
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/pro_showcase_feature_row_gap"
                    android:orientation="horizontal" android:gravity="center_vertical">
                    <ImageView style="@style/ProShowcaseFeatureIcon"
                        android:src="@drawable/ic_pro_feature_updates" />
                    <TextView style="@style/ProShowcaseFeatureLabel"
                        android:layout_marginStart="@dimen/pro_showcase_feature_gap"
                        android:text="@string/pro_showcase_chip_updates" />
                </LinearLayout>

                <!-- Coming-soon row: the label takes the leftover width and wraps (three lines at
                     most), the pill keeps its intrinsic width. A weight split cannot push the pill
                     past the column edge and under the phone the way a wrap-to-wrap constraint
                     chain can. Only the label and its glyph are muted — never the whole row, so
                     the pill stays readable. -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/pro_showcase_feature_row_gap"
                    android:orientation="horizontal" android:gravity="center_vertical">

                    <ImageView style="@style/ProShowcaseFeatureIcon"
                        android:src="@drawable/ic_pro_feature_disguise"
                        android:tint="@color/pro_card_text_muted" />

                    <TextView android:id="@+id/entryLabel"
                        style="@style/ProShowcaseFeatureLabel"
                        android:layout_marginStart="@dimen/pro_showcase_feature_gap"
                        android:textColor="@color/pro_card_text_muted"
                        android:text="@string/pro_showcase_chip_entry" />

                    <TextView android:id="@+id/entrySoon"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/pro_showcase_chip_gap"
                        android:background="@drawable/bg_pro_showcase_soon"
                        android:paddingHorizontal="@dimen/pro_showcase_soon_pad_h"
                        android:paddingVertical="@dimen/pro_showcase_soon_pad_v"
                        android:maxLines="1"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.1"
                        android:text="@string/pro_showcase_soon"
                        android:textColor="@color/pro_card_soon_text"
                        android:textSize="@dimen/pro_showcase_soon_size" />
                </LinearLayout>
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="0dp"
                android:layout_weight="1" android:minHeight="@dimen/pro_showcase_rule_gap" />

            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="@color/pro_card_divider" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/pro_showcase_footer_gap"
                android:orientation="horizontal" android:gravity="center_vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="touch_app" android:fontFamily="@font/materialicons"
                    android:textSize="@dimen/pro_showcase_hint_glyph"
                    android:textColor="@color/pro_card_text_secondary"
                    android:importantForAccessibility="no" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginStart="@dimen/pro_showcase_hint_gap"
                    android:maxLines="2"
                    android:text="@string/pro_showcase_hint"
                    android:textColor="@color/pro_card_text_secondary"
                    android:textSize="@dimen/pro_showcase_hint_size" />
                <TextView android:id="@+id/showcaseExpand"
                    android:layout_width="@dimen/pro_showcase_expand_size"
                    android:layout_height="@dimen/pro_showcase_expand_size"
                    android:layout_marginStart="@dimen/pro_showcase_expand_gap" android:gravity="center"
                    android:background="@drawable/bg_pro_showcase_expand"
                    android:clickable="true" android:focusable="true"
                    android:contentDescription="@string/pro_showcase_expand_desc"
                    android:text="fullscreen" android:fontFamily="@font/materialicons"
                    android:textSize="@dimen/pro_showcase_expand_glyph"
                    android:textColor="@color/pro_card_champagne" />
            </LinearLayout>
        </LinearLayout>

        <!-- The phone slot is fluid: it takes a share of the row (weight from the width bucket)
             and its height follows its width through the device's own aspect ratio, so the
             composition is the same on a 360dp phone and a 480dp one instead of the phone
             eating a fixed 150dp out of the text column. -->
        <com.fadcam.ui.widgets.AspectRatioFrameLayout android:id="@+id/showcasePhoneWrapper"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="@dimen/pro_showcase_phone_weight"
            android:layout_marginStart="@dimen/pro_showcase_gap"
            app:aspectRatio="2.05"
            android:contentDescription="@string/pro_showcase_phone_desc"
            android:clipChildren="false" android:clipToPadding="false">
            <FrameLayout android:id="@+id/showcasePhoneContainer"
                android:layout_width="match_parent" android:layout_height="match_parent" />
        </com.fadcam.ui.widgets.AspectRatioFrameLayout>
    </LinearLayout>
</LinearLayout>
