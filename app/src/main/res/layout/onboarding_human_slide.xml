<?xml version="1.0" encoding="utf-8"?>
<!-- Onboarding 04: the oath. Flag rain stays; everything else joins the dossier system. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:clipToPadding="true"
    android:fillViewport="true"
    android:scrollbars="none">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.fadcam.ui.widgets.DossierPaperView
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <com.fadcam.ui.PalestineRainView
            android:id="@+id/palestineRainView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0.22" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:id="@+id/onboarding_content"
            android:paddingStart="@dimen/onboarding_dossier_pad"
            android:paddingEnd="@dimen/onboarding_dossier_pad"
            android:paddingTop="20dp"
            android:paddingBottom="@dimen/onboarding_bottom_inset">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/onboardingPage"
                    style="@style/ProDossierHeader"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:text="@string/onboarding_human_page"
                    android:textDirection="ltr" />

                <TextView
                    style="@style/ProDossierHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_marginEnd="8dp"
                    android:layout_toStartOf="@id/onboardingPage"
                    android:text="@string/onboarding_human_kicker"
                    android:textAlignment="viewStart" />
            </RelativeLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="6dp"
                android:background="@color/dossier_line" />

            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/lottieHuman"
                android:layout_width="160dp"
                android:layout_height="96dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp"
                app:lottie_autoPlay="true"
                app:lottie_fileName="document_rules_green_checkmark.json"
                app:lottie_loop="true" />

            <TextView
                android:id="@+id/tvHumanTitle"
                style="@style/ProDossierTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:text="@string/onboarding_human_title"
                android:textSize="@dimen/onboarding_dossier_title_size" />

            <TextView
                android:id="@+id/tvHumanDesc"
                style="@style/ProDossierBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="@string/onboarding_human_desc"
                android:textSize="13sp" />

            <LinearLayout
                android:id="@+id/checkbox_row_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="12dp"
                android:paddingBottom="12dp">

                <TextView
                    android:layout_width="28dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="01"
                    android:textColor="@color/dossier_olive_bright"
                    android:textSize="11sp" />

                <ImageView
                    android:id="@+id/checkbox_icon_1"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="12dp"
                    android:contentDescription="@string/onboarding_human_checkbox1"
                    android:padding="2dp"
                    android:src="@drawable/placeholder_checkbox_outline"
                    android:tint="@color/dossier_ink" />

                <TextView
                    android:id="@+id/checkbox_label_1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="monospace"
                    android:text="@string/onboarding_human_checkbox1"
                    android:textColor="@color/dossier_ink"
                    android:textSize="13sp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/dossier_line" />

            <LinearLayout
                android:id="@+id/checkbox_row_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="12dp"
                android:paddingBottom="12dp">

                <TextView
                    android:layout_width="28dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="02"
                    android:textColor="@color/dossier_olive_bright"
                    android:textSize="11sp" />

                <ImageView
                    android:id="@+id/checkbox_icon_2"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="12dp"
                    android:contentDescription="@string/onboarding_human_checkbox2"
                    android:padding="2dp"
                    android:src="@drawable/placeholder_checkbox_outline"
                    android:tint="@color/dossier_ink" />

                <TextView
                    android:id="@+id/checkbox_label_2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="monospace"
                    android:text="@string/onboarding_human_checkbox2"
                    android:textColor="@color/dossier_ink"
                    android:textSize="13sp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/dossier_line" />

            <LinearLayout
                android:id="@+id/checkbox_row_3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="12dp"
                android:paddingBottom="12dp">

                <TextView
                    android:layout_width="28dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="03"
                    android:textColor="@color/dossier_olive_bright"
                    android:textSize="11sp" />

                <ImageView
                    android:id="@+id/checkbox_icon_3"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="12dp"
                    android:contentDescription="@string/onboarding_human_checkbox3"
                    android:padding="2dp"
                    android:src="@drawable/placeholder_checkbox_outline"
                    android:tint="@color/dossier_ink" />

                <TextView
                    android:id="@+id/checkbox_label_3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="monospace"
                    android:text="@string/onboarding_human_checkbox3"
                    android:textColor="@color/dossier_ink"
                    android:textSize="13sp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/dossier_line" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_human_continue"
                style="@style/ProDossierButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/onboarding_human_button" />
        </LinearLayout>
    </FrameLayout>
</ScrollView>
