<?xml version="1.0" encoding="utf-8"?>
<!-- Onboarding 04: the oath. Flag rain stays; everything else joins the dossier system. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:clipToPadding="true"
    android:fillViewport="true"
    android:scrollbars="none">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.fadcam.ui.widgets.DossierPaperView
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <com.fadcam.ui.PalestineRainView
            android:id="@+id/palestineRainView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0.22" />

        <LinearLayout
            android:id="@+id/onboarding_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="@dimen/onboarding_dossier_pad"
            android:paddingTop="20dp"
            android:paddingEnd="@dimen/onboarding_dossier_pad"
            android:paddingBottom="@dimen/onboarding_bottom_inset">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/onboardingPage"
                    style="@style/ProDossierHeader"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:text="@string/onboarding_human_page"
                    android:textDirection="ltr" />

                <TextView
                    style="@style/ProDossierHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_marginEnd="8dp"
                    android:layout_toStartOf="@id/onboardingPage"
                    android:text="@string/onboarding_human_kicker"
                    android:textAlignment="viewStart" />
            </RelativeLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="6dp"
                android:background="@color/dossier_line" />

            <!-- Flexible lead-in: the oath group leans toward the centre of the
                 screen while the dossier header stays pinned to the top. -->
            <Space
                android:layout_width="1dp"
                android:layout_height="0dp"
                android:layout_weight="0.44" />

            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/lottieHuman"
                android:layout_width="160dp"
                android:layout_height="96dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp"
                app:lottie_autoPlay="true"
                app:lottie_fileName="document_rules_green_checkmark.json"
                app:lottie_loop="true" />

            <TextView
                android:id="@+id/tvHumanTitle"
                style="@style/ProDossierTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:text="@string/onboarding_human_title"
                android:textSize="@dimen/onboarding_dossier_title_size" />

            <TextView
                android:id="@+id/tvHumanDesc"
                style="@style/ProDossierBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="@string/onboarding_human_desc"
                android:textSize="13sp" />

            <!-- One panel holds both agreements. Rows are the touch targets; the legal
                 links inside row two keep their own click handling. -->
            <LinearLayout
                android:id="@+id/agreement_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_onboarding_agreement"
                android:clipToOutline="true"
                android:orientation="vertical"
                android:paddingTop="8dp"
                android:paddingBottom="8dp">

                <LinearLayout
                    android:id="@+id/checkbox_row_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="48dp"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="6dp">

                    <ImageView
                        android:id="@+id/checkbox_icon_1"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_marginEnd="12dp"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:src="@drawable/placeholder_checkbox_outline"
                        android:tint="@color/dossier_ink" />

                    <TextView
                        android:id="@+id/checkbox_label_1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="monospace"
                        android:lineSpacingExtra="2dp"
                        android:text="@string/onboarding_human_agreement_responsible"
                        android:textColor="@color/dossier_ink"
                        android:textSize="13sp" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="14dp"
                    android:layout_marginTop="2dp"
                    android:layout_marginEnd="14dp"
                    android:layout_marginBottom="2dp"
                    android:background="@color/dossier_line" />

                <LinearLayout
                    android:id="@+id/checkbox_row_2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="48dp"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="6dp">

                    <ImageView
                        android:id="@+id/checkbox_icon_2"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_marginEnd="12dp"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:src="@drawable/placeholder_checkbox_outline"
                        android:tint="@color/dossier_ink" />

                    <TextView
                        android:id="@+id/checkbox_label_2"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="monospace"
                        android:lineSpacingExtra="2dp"
                        android:textColor="@color/dossier_ink"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_human_continue"
                style="@style/ProDossierButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/onboarding_human_button" />

            <Space
                android:layout_width="1dp"
                android:layout_height="0dp"
                android:layout_weight="0.56" />
        </LinearLayout>
    </FrameLayout>
</ScrollView>
