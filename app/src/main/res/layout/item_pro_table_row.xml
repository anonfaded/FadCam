<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:gravity="center_vertical"
    android:minHeight="@dimen/pro_table_row_min_h" android:paddingVertical="14dp" android:paddingHorizontal="12dp">
    <FrameLayout android:layout_width="@dimen/pro_row_icon_slot" android:layout_height="@dimen/pro_row_icon_slot"
        android:layout_marginEnd="10dp" android:importantForAccessibility="no">
        <TextView android:id="@+id/tvRowIcon" android:layout_width="match_parent" android:layout_height="match_parent"
            android:fontFamily="@font/materialicons" android:gravity="center" android:textSize="@dimen/pro_row_icon_text"
            android:textColor="@color/pro_gold" />
        <ImageView android:id="@+id/ivRowImage" android:layout_width="@dimen/pro_row_icon_image" android:layout_height="@dimen/pro_row_icon_image"
            android:layout_gravity="center" android:visibility="gone" android:contentDescription="@null" />
    </FrameLayout>
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:orientation="vertical" android:paddingEnd="8dp">
        <TextView android:id="@+id/tvFeatureName" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="@color/pro_text" android:textSize="14sp" android:fontFamily="sans-serif-medium" />
        <TextView android:id="@+id/tvFeatureDesc" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="@color/pro_text_secondary" android:textSize="12sp" android:layout_marginTop="4dp" android:lineSpacingExtra="2dp" />
    </LinearLayout>
    <LinearLayout android:id="@+id/statusContainer" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical" />
</LinearLayout>
