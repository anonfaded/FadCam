<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/picker_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingEnd="12dp"
    android:paddingTop="12dp"
    android:paddingBottom="24dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <ImageView
            android:id="@+id/picker_close_btn"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginEnd="12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_close"
            android:tint="?attr/pickerTextSecondary" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/mini_apps_customize_title"
            android:textColor="?attr/colorHeading"
            android:textSize="18sp"
            android:textStyle="bold" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="16dp"
        android:background="#404040" />

    <!-- Count stepper card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/settings_group_card_bg"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/mini_apps_show_count"
                android:textColor="?attr/colorHeading"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/mini_apps_show_count_desc"
                android:textColor="@android:color/darker_gray"
                android:textSize="11sp"
                android:maxLines="1"
                android:ellipsize="end" />

        </LinearLayout>

        <TextView
            android:id="@+id/reorder_count_minus"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:fontFamily="@font/materialicons"
            android:text="remove"
            android:textSize="20sp"
            android:textColor="?attr/colorHeading"
            android:gravity="center"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/desc_mini_apps_count_minus" />

        <TextView
            android:id="@+id/reorder_count_value"
            android:layout_width="44dp"
            android:layout_height="wrap_content"
            android:text="5"
            android:textColor="?attr/colorHeading"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center" />

        <TextView
            android:id="@+id/reorder_count_plus"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:fontFamily="@font/materialicons"
            android:text="add"
            android:textSize="20sp"
            android:textColor="?attr/colorHeading"
            android:gravity="center"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/desc_mini_apps_count_plus" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="12dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="12dp"
        android:background="#404040" />

    <!-- Reorder list -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="420dp">

        <LinearLayout
            android:id="@+id/reorder_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/settings_group_card_bg" />

    </ScrollView>

    <!-- Footer -->
    <TextView
        android:id="@+id/picker_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="start"
        android:textSize="11sp"
        android:textColor="?attr/homeRailTextSecondary"
        android:paddingTop="2dp"
        android:paddingBottom="4dp"
        android:layout_marginTop="12dp"
        android:text="@string/mini_apps_reorder_footer" />

</LinearLayout>