<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main_root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:colorBackground"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:descendantFocusability="beforeDescendants">

    <!-- Status bar scrim: height is dynamically set via ConstraintSet in MainActivity -->
    <!-- For phones: height = statusBars.top, For TV/Wear: height = 0 -->
    <View
        android:id="@+id/status_bar_scrim"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="?attr/colorTopBar"
        android:elevation="11dp"
        android:outlineProvider="none"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <FrameLayout
        android:id="@+id/fragment_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:focusable="false"
        android:clipToPadding="false"
        android:clipChildren="false"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Full bottom focus scrim around dock -->
    <View
        android:id="@+id/dock_focus_gradient_scrim"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:layout_marginBottom="0dp"
        android:background="@drawable/dock_focus_gradient"
        android:clickable="false"
        android:focusable="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <FrameLayout
        android:id="@+id/nav_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/home_dock_padding"
        android:paddingEnd="@dimen/home_dock_padding"
        android:paddingBottom="@dimen/home_dock_padding"
        android:clipChildren="false"
        android:clipToPadding="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottom_navigation"
            android:layout_width="match_parent"
            android:layout_height="@dimen/home_dock_height"
            android:layout_gravity="bottom"
            android:elevation="12dp"
            android:background="?attr/colorBottomNav"
            android:clipToOutline="true"
            android:focusable="true"
            android:focusableInTouchMode="false"
            android:nextFocusUp="@+id/fragment_container"
            android:nextFocusDown="@+id/bottom_navigation"
            app:itemIconSize="@dimen/home_dock_icon"
            app:itemIconTint="@color/bottom_nav_icon_tint"
            app:itemTextColor="@android:color/white"
            app:itemActiveIndicatorStyle="@null"
            app:menu="@menu/bottom_nav_menu" />
        <!-- Lite compact dock (enhanced duplicate; drives the hidden nav above) -->
        <LinearLayout
            android:id="@+id/lite_dock"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/home_dock_height"
            android:layout_gravity="bottom|center_horizontal"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="@dimen/home_dock_padding"
            android:paddingEnd="@dimen/home_dock_padding"
            android:elevation="12dp"
            android:visibility="gone">

<LinearLayout
                android:id="@+id/lite_dock_item_records"
                android:layout_width="@dimen/home_dock_side_width_wide"
                android:layout_height="@dimen/home_dock_side_height"
                android:orientation="vertical"
                android:gravity="center"
                android:animateLayoutChanges="true"
                android:paddingEnd="@dimen/home_dock_side_inset"
                android:layout_marginEnd="-34dp"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:id="@+id/lite_dock_icon_records"
                    android:layout_width="@dimen/home_dock_icon"
                    android:layout_height="@dimen/home_dock_icon"
                    android:src="@drawable/ic_records_selector"
                    android:contentDescription="@string/nav_records" />
            </LinearLayout>

<LinearLayout
                android:id="@+id/lite_dock_item_home"
                android:layout_width="@dimen/home_dock_height"
                android:layout_height="@dimen/home_dock_height"
                android:orientation="vertical"
                android:gravity="center"
                android:animateLayoutChanges="true"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:id="@+id/lite_dock_icon_home"
                    android:layout_width="@dimen/home_dock_icon"
                    android:layout_height="@dimen/home_dock_icon"
                    android:src="@drawable/pilot_steering_white"
                    android:contentDescription="@string/nav_home" />
                <TextView
                    android:id="@+id/lite_dock_label_home"
                    android:paddingTop="2dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/nav_home"
                    android:textColor="#FFFFFF" />
            </LinearLayout>

<LinearLayout
                android:id="@+id/lite_dock_item_settings"
                android:layout_width="@dimen/home_dock_side_width_wide"
                android:layout_height="@dimen/home_dock_side_height"
                android:orientation="vertical"
                android:gravity="center"
                android:animateLayoutChanges="true"
                android:paddingStart="@dimen/home_dock_side_inset"
                android:layout_marginStart="-34dp"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:id="@+id/lite_dock_icon_settings"
                    android:layout_width="@dimen/home_dock_icon"
                    android:layout_height="@dimen/home_dock_icon"
                    android:src="@drawable/ic_nav_settings"
                    android:contentDescription="@string/nav_settings" />
            </LinearLayout>        </LinearLayout>

        </FrameLayout>

    <!-- ********************************************************** -->
    <!-- *** ADD THIS FRAMELAYOUT FOR OVERLAY FRAGMENTS (like TrashFragment) *** -->
    <!-- ********************************************************** -->
    <FrameLayout
        android:id="@+id/overlay_fragment_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
    android:clickable="true"
    android:focusable="true"
    android:focusableInTouchMode="true"
        android:background="?android:colorBackground"
        android:elevation="10dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
    <!-- ********************************************************** -->

</androidx.constraintlayout.widget.ConstraintLayout>
