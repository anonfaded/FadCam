<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#0B0B0D">

    <com.fadcam.ui.widgets.ProBundleShowcaseView android:id="@+id/fullscreenShowcase"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_gravity="center" />

    <TextView android:id="@+id/fullscreenClose"
        android:layout_width="40dp" android:layout_height="40dp" android:gravity="center"
        android:layout_gravity="top|start" android:layout_margin="18dp"
        android:background="@drawable/bg_pro_showcase_chip"
        android:text="close" android:fontFamily="@font/materialicons"
        android:textSize="19sp" android:textColor="@color/pro_text" />


</FrameLayout>
