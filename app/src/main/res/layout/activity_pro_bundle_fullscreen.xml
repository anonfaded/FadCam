<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/fullscreenRoot"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#0B0B0D">

    <com.fadcam.ui.widgets.ProBundleShowcaseView android:id="@+id/fullscreenShowcase"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_gravity="center" />

    <TextView android:id="@+id/fullscreenClose"
        android:layout_width="44dp" android:layout_height="44dp" android:gravity="center"
        android:layout_gravity="top|start"
        android:background="@drawable/picker_circle_btn"
        app:backgroundTint="#80000000"
        android:text="close" android:fontFamily="@font/materialicons"
        android:textSize="20sp" android:textColor="@color/pro_text" />

</FrameLayout>
