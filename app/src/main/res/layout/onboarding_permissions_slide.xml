<?xml version="1.0" encoding="utf-8"?>
<!-- Onboarding 03: access clearance. Same dossier sheet as the rest of the flow. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:clipToPadding="true"
    android:paddingBottom="@dimen/onboarding_bottom_inset"
    android:fillViewport="true"
    android:scrollbars="none">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.fadcam.ui.widgets.DossierPaperView
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:id="@+id/onboarding_content"
            android:paddingStart="@dimen/onboarding_dossier_pad"
            android:paddingEnd="@dimen/onboarding_dossier_pad"
            android:paddingTop="20dp"
            android:paddingBottom="0dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/onboardingPage"
                    style="@style/ProDossierHeader"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:text="@string/onboarding_permissions_page"
                    android:textDirection="ltr" />

                <TextView
                    style="@style/ProDossierHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_marginEnd="8dp"
                    android:layout_toStartOf="@id/onboardingPage"
                    android:text="@string/onboarding_permissions_kicker"
                    android:textAlignment="viewStart" />
            </RelativeLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="6dp"
                android:background="@color/dossier_line" />

            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/lottiePermissions"
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="18dp"
                app:lottie_autoPlay="true"
                app:lottie_fileName="document_stamp_green_checkmark.json"
                app:lottie_loop="true" />

            <TextView
                android:id="@+id/permissionsTitle"
                style="@style/ProDossierTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:text="@string/permissions_required"
                android:textSize="@dimen/onboarding_dossier_title_size" />

            <TextView
                android:id="@+id/permissionsDescription"
                style="@style/ProDossierBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="@string/permissions_description"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/permission_status_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="monospace"
                android:gravity="center"
                android:text="@string/permissions_granted"
                android:textColor="@color/green"
                android:textSize="12sp"
                android:visibility="gone" />

            <!-- Keep the three LinearLayout children: the fragment refreshes their labels. -->
            <LinearLayout
                android:id="@+id/permissionsListContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_margin="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_onboarding_chip"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:contentDescription="@string/onboarding_camera"
                        android:src="@drawable/ic_camera"
                        android:tint="@color/dossier_olive_bright" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="monospace"
                        android:text="@string/onboarding_camera"
                        android:textColor="@color/dossier_ink"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_margin="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_onboarding_chip"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:contentDescription="@string/onboarding_microphone"
                        android:src="@drawable/ic_mic"
                        android:tint="@color/dossier_olive_bright" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="monospace"
                        android:text="@string/onboarding_microphone"
                        android:textColor="@color/dossier_ink"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_margin="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_onboarding_chip"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:contentDescription="@string/onboarding_storage"
                        android:src="@drawable/ic_save2"
                        android:tint="@color/dossier_olive_bright" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="monospace"
                        android:text="@string/onboarding_storage"
                        android:textColor="@color/dossier_ink"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/permissions_grant_button"
                style="@style/ProDossierButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/grant_permissions" />

            <TextView
                android:id="@+id/or_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="monospace"
                android:gravity="center"
                android:text="@string/onboarding_or"
                android:textColor="@color/dossier_muted"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/open_settings_link"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="monospace"
                android:gravity="center"
                android:text="@string/onboarding_open_settings"
                android:textColor="@color/dossier_olive_bright"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/and_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="monospace"
                android:gravity="center"
                android:text="@string/onboarding_and"
                android:textColor="@color/dossier_muted"
                android:textSize="11sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/disable_battery_optimization_button"
                style="@style/ProDossierButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/disable_battery_optimization" />

            <TextView
                android:id="@+id/permissionsNote"
                style="@style/ProDossierBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:text="@string/permissions_note"
                android:textSize="11sp" />
        </LinearLayout>
    </FrameLayout>
</ScrollView>
