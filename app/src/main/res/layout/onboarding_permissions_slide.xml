<?xml version="1.0" encoding="utf-8"?>
<!-- Onboarding 03: access clearance. Same dossier sheet as the rest of the flow. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:clipToPadding="true"
    android:fillViewport="true"
    android:scrollbars="none">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.fadcam.ui.widgets.DossierPaperView
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <LinearLayout
            android:id="@+id/onboarding_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="@dimen/onboarding_dossier_pad"
            android:paddingTop="20dp"
            android:paddingEnd="@dimen/onboarding_dossier_pad"
            android:paddingBottom="@dimen/onboarding_bottom_inset">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/onboardingPage"
                    style="@style/ProDossierHeader"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:text="@string/onboarding_permissions_page"
                    android:textDirection="ltr" />

                <TextView
                    style="@style/ProDossierHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_marginEnd="8dp"
                    android:layout_toStartOf="@id/onboardingPage"
                    android:text="@string/onboarding_permissions_kicker"
                    android:textAlignment="viewStart" />
            </RelativeLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="6dp"
                android:background="@color/dossier_line" />

            <!-- Flexible lead-in: the whole permission group sits just above the
                 visual centre, while the dossier header stays pinned to the top. -->
            <Space
                android:layout_width="1dp"
                android:layout_height="0dp"
                android:layout_weight="0.36" />

            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/lottiePermissions"
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="18dp"
                app:lottie_autoPlay="true"
                app:lottie_fileName="document_stamp_green_checkmark.json"
                app:lottie_loop="true" />

            <TextView
                android:id="@+id/permissionsTitle"
                style="@style/ProDossierTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:text="@string/permissions_required"
                android:textSize="@dimen/onboarding_dossier_title_size" />

            <TextView
                android:id="@+id/permissionsDescription"
                style="@style/ProDossierBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="@string/permissions_description"
                android:textSize="13sp" />

            <TextView
                style="@style/ProDossierLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/onboarding_permissions_section" />

            <!-- Three compact permission tiles. The fragment refreshes labels and
                 status words in place, so the structure stays fixed. -->
            <LinearLayout
                android:id="@+id/permissionsListContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_margin="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_onboarding_tile"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingStart="6dp"
                    android:paddingTop="14dp"
                    android:paddingEnd="6dp"
                    android:paddingBottom="14dp">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:contentDescription="@string/onboarding_camera"
                        android:src="@drawable/ic_camera"
                        android:tint="@color/dossier_olive_bright" />

                    <TextView
                        android:id="@+id/permission_camera_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="monospace"
                        android:text="@string/onboarding_camera"
                        android:textColor="@color/dossier_ink"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/permission_status_camera"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:fontFamily="monospace"
                        android:letterSpacing="0.08"
                        android:text="@string/onboarding_permission_required"
                        android:textAllCaps="true"
                        android:textColor="@color/dossier_muted"
                        android:textSize="8.5sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_margin="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_onboarding_tile"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingStart="6dp"
                    android:paddingTop="14dp"
                    android:paddingEnd="6dp"
                    android:paddingBottom="14dp">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:contentDescription="@string/onboarding_microphone"
                        android:src="@drawable/ic_mic"
                        android:tint="@color/dossier_olive_bright" />

                    <TextView
                        android:id="@+id/permission_microphone_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="monospace"
                        android:text="@string/onboarding_microphone"
                        android:textColor="@color/dossier_ink"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/permission_status_microphone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:fontFamily="monospace"
                        android:letterSpacing="0.08"
                        android:text="@string/onboarding_permission_required"
                        android:textAllCaps="true"
                        android:textColor="@color/dossier_muted"
                        android:textSize="8.5sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_margin="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_onboarding_tile"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingStart="6dp"
                    android:paddingTop="14dp"
                    android:paddingEnd="6dp"
                    android:paddingBottom="14dp">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:contentDescription="@string/onboarding_storage"
                        android:src="@drawable/ic_save2"
                        android:tint="@color/dossier_olive_bright" />

                    <TextView
                        android:id="@+id/permission_storage_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="monospace"
                        android:text="@string/onboarding_storage"
                        android:textColor="@color/dossier_ink"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/permission_status_storage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:fontFamily="monospace"
                        android:letterSpacing="0.08"
                        android:text="@string/onboarding_permission_required"
                        android:textAllCaps="true"
                        android:textColor="@color/dossier_muted"
                        android:textSize="8.5sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Permission state: one action while something is missing, one compact
                 success row once everything is granted. Never a fake gold button. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/permissions_grant_button"
                style="@style/ProDossierButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/grant_permissions" />

            <LinearLayout
                android:id="@+id/permission_success_row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_check"
                    android:tint="@color/onboarding_success" />

                <TextView
                    android:id="@+id/permission_status_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="7dp"
                    android:fontFamily="monospace"
                    android:text="@string/permissions_granted"
                    android:textColor="@color/onboarding_success"
                    android:textSize="11.5sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/open_settings_link"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="monospace"
                android:gravity="center"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:text="@string/onboarding_open_settings"
                android:textColor="@color/dossier_olive_bright"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="18dp"
                android:background="@color/dossier_line" />

            <TextView
                style="@style/ProDossierLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/onboarding_battery_section" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/disable_battery_optimization_button"
                style="@style/ProDossierButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/disable_battery_optimization" />

            <LinearLayout
                android:id="@+id/battery_success_row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_check"
                    android:tint="@color/onboarding_success" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="7dp"
                    android:fontFamily="monospace"
                    android:text="@string/battery_optimization_disabled"
                    android:textColor="@color/onboarding_success"
                    android:textSize="11.5sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/permissionsNote"
                style="@style/ProDossierBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:text="@string/permissions_note"
                android:textSize="11sp" />

            <Space
                android:layout_width="1dp"
                android:layout_height="0dp"
                android:layout_weight="0.64" />
        </LinearLayout>
    </FrameLayout>
</ScrollView>
