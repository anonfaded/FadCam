<?xml version="1.0" encoding="utf-8"?>
<!-- The row is stretched to fill the controls card on narrow screens, so it hands its
     resolved height down to every tile (the glass pill is on the inner TextView, not
     the FrameLayout — a wrap_content FrameLayout would leave it short). -->
<com.fadcam.ui.widgets.EqualHeightRowLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/home_tile_height"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingTop="2dp"
    android:paddingBottom="2dp"
    android:weightSum="3">

    <!-- AF mode toggle (continuous / off) — lock status icon bottom-right -->
    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginEnd="@dimen/home_tile_gap"
        android:minHeight="@dimen/home_tile_height">

        <TextView
            android:id="@+id/tile_af_toggle"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/home_tile_bg_glass"
            android:gravity="center"
            android:fontFamily="@font/materialicons"
            android:text="center_focus_strong"
            android:contentDescription="@string/desc_autofocus_toggle"
            android:textColor="?attr/homeRailTextPrimary"
            android:textSize="@dimen/home_tile_icon_size"
            android:paddingStart="@dimen/home_tile_padding"
            android:paddingEnd="@dimen/home_tile_padding"
            android:paddingTop="@dimen/home_tile_padding"
            android:paddingBottom="@dimen/home_tile_padding"
            android:clickable="true"
            android:focusable="true"
            android:nextFocusUp="@+id/cardStats"
            android:nextFocusDown="@+id/cardRailTogglePortrait" />

        <TextView
            android:id="@+id/tile_af_status_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginBottom="@dimen/home_tile_label_margin_bottom"
            android:layout_marginEnd="@dimen/home_tile_label_margin_end"
            android:text="lock_open"
            android:textColor="#FFFFFF"
            android:textSize="@dimen/home_tile_status_text"
            android:fontFamily="@font/materialicons"
            android:includeFontPadding="false" />
    </FrameLayout>

    <!-- Exposure (single tile opens slider picker) — value label bottom-right -->
    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginEnd="@dimen/home_tile_gap"
        android:minHeight="@dimen/home_tile_height">

        <TextView
            android:id="@+id/tile_exp"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/home_tile_bg_glass"
            android:gravity="center"
            android:text="exposure"
            android:fontFamily="@font/materialicons"
            android:textSize="@dimen/home_tile_icon_size"
            android:contentDescription="@string/desc_exposure_compensation"
            android:textColor="?attr/homeRailTextPrimary"
            android:paddingStart="@dimen/home_tile_padding"
            android:paddingEnd="@dimen/home_tile_padding"
            android:paddingTop="@dimen/home_tile_padding"
            android:paddingBottom="@dimen/home_tile_padding"
            android:clickable="true"
            android:focusable="true"
            android:nextFocusUp="@+id/cardStats"
            android:nextFocusDown="@+id/cardRailTogglePortrait" />

        <TextView
            android:id="@+id/tile_exp_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:textDirection="ltr"
            android:layout_marginBottom="@dimen/home_tile_label_margin_bottom"
            android:layout_marginEnd="@dimen/home_tile_label_margin_end"
            android:text="+0.0"
            android:textColor="#FFFFFF"
            android:textSize="@dimen/home_tile_label_size"
            android:fontFamily="monospace"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:includeFontPadding="false" />
    </FrameLayout>

    <!-- Zoom ratio (quick access to zoom settings) — level label bottom-right -->
    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:minHeight="@dimen/home_tile_height">

        <TextView
            android:id="@+id/tile_zoom"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/home_tile_bg_glass"
            android:paddingStart="@dimen/home_tile_padding"
            android:paddingEnd="@dimen/home_tile_padding"
            android:paddingTop="@dimen/home_tile_padding"
            android:paddingBottom="@dimen/home_tile_padding"
            android:gravity="center"
            android:text="zoom_in"
            android:fontFamily="@font/materialicons"
            android:textSize="@dimen/home_tile_icon_size"
            android:contentDescription="@string/desc_zoom_ratio"
            android:textColor="?attr/homeRailTextPrimary"
            android:clickable="true"
            android:focusable="true"
            android:nextFocusUp="@+id/cardStats"
            android:nextFocusDown="@+id/cardRailTogglePortrait" />

        <TextView
            android:id="@+id/tile_zoom_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:textDirection="ltr"
            android:layout_marginBottom="@dimen/home_tile_label_margin_bottom"
            android:layout_marginEnd="@dimen/home_tile_label_margin_end"
            android:text="1.0x"
            android:textColor="#FFFFFF"
            android:textSize="@dimen/home_tile_label_size"
            android:fontFamily="monospace"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:includeFontPadding="false" />
    </FrameLayout>

</com.fadcam.ui.widgets.EqualHeightRowLayout>
