<?xml version="1.0" encoding="utf-8"?>
<resources>
    <attr name="colorTopBar" format="color" />
    <attr name="colorBottomNav" format="color" />
    <attr name="colorHeading" format="color" />
    <attr name="colorButton" format="color" />
    <attr name="colorToggle" format="color" />
    <attr name="colorSwitchTrack" format="color" />
    <attr name="colorDialog" format="color" />
    <attr name="colorStatusBar" format="color" />
    <!-- Picker gradient attributes -->
    <attr name="pickerGradientStart" format="color" />
    <attr name="pickerGradientMid" format="color" />
    <attr name="pickerGradientEnd" format="color" />
    <!-- Picker text color attributes -->
    <attr name="pickerTextPrimary" format="color" />
    <attr name="pickerTextSecondary" format="color" />
    <!-- Section header color attribute -->
    <attr name="sectionHeaderColor" format="color" />
    <!-- Picker component color attributes for theme-specific styling -->
    <attr name="pickerButtonBackground" format="color" />
    <attr name="pickerButtonText" format="color" />
    <attr name="pickerIconTint" format="color" />
    <attr name="pickerSliderActive" format="color" />
    <attr name="pickerSliderInactive" format="color" />
    <attr name="homeRailBgStart" format="color" />
    <attr name="homeRailBgEnd" format="color" />
    <attr name="homeRailCardSurface" format="color" />
    <attr name="homeRailCardBorder" format="color" />
    <attr name="homeRailCardStroke" format="color" />
    <attr name="homeRailTileSurface" format="color" />
    <attr name="homeRailSegmentedSurface" format="color" />
    <attr name="homeRailSegmentedBorder" format="color" />
    <attr name="homeRailSegmentActive" format="color" />
    <attr name="homeRailSegmentActiveText" format="color" />
    <attr name="homeRailTextPrimary" format="color" />
    <attr name="homeRailTextSecondary" format="color" />
    <attr name="homeRailAccent" format="color" />

    <declare-styleable name="AspectRatioFrameLayout">
        <!-- Height / width of the slot. The showcase keeps it equal to the phone model's aspect. -->
        <attr name="aspectRatio" format="float" />
    </declare-styleable>

    <declare-styleable name="TornPaperImageView">
        <attr name="tearAmplitude" format="dimension" />
        <attr name="tearFrequency" format="float" />
        <attr name="paperTint" format="color" />
        <attr name="grainAlpha" format="float" />
        <attr name="edgeShadowAlpha" format="float" />
        <attr name="seedKey" format="string" />
    </declare-styleable>

    <declare-styleable name="ShowcaseGridLightView">
        <!-- Sibling view whose bounds become the light source (the phone slot, an avatar). -->
        <attr name="lightSubject" format="reference" />
        <!-- Corner registration marks; off inside small preview stages that already have a frame. -->
        <attr name="cornerMarks" format="boolean" />
    </declare-styleable>

    <!-- Reusable icon button with a tiny ON/OFF-style label in the corner.
         Used by the torch, mirror and FadRec mute controls so they share one
         measurement/label implementation instead of three duplicated layouts. -->
    <declare-styleable name="StatusControlButton">
        <attr name="scb_icon" format="reference" />
        <attr name="scb_iconSize" format="dimension" />
        <attr name="scb_iconTint" format="color" />
        <attr name="scb_background" format="reference" />
        <attr name="scb_buttonGone" format="boolean" />
        <attr name="scb_buttonId" format="reference" />
        <attr name="scb_statusId" format="reference" />
        <attr name="scb_centerIconId" format="reference" />
        <attr name="scb_statusText" format="string" />
        <attr name="scb_statusTextColor" format="color" />
        <attr name="scb_statusTextSize" format="dimension" />
        <attr name="scb_statusMarginBottom" format="dimension" />
        <attr name="scb_statusMarginEnd" format="dimension" />
        <attr name="scb_centerIconText" format="string" />
        <attr name="scb_centerIconSize" format="dimension" />
        <attr name="scb_centerIconColor" format="color" />
        <attr name="scb_nextFocusUp" format="reference" />
        <attr name="scb_nextFocusDown" format="reference" />
    </declare-styleable>
</resources>
