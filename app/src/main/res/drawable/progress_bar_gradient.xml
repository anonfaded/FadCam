<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Empty track blends into the header panel -->
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <solid android:color="@color/dark_card_background" />
        </shape>
    </item>
    <!-- Filled progress uses the dossier red accent -->
    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <gradient
                    android:type="linear"
                    android:angle="0"
                    android:startColor="#B3322F"
                    android:centerColor="#E43C3C"
                    android:endColor="#FF6161" />
            </shape>
        </clip>
    </item>
</layer-list>
