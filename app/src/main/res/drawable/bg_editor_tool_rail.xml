<?xml version="1.0" encoding="utf-8"?>
<!-- Landscape tool rail. Rounded on the inner edge so it reads as a panel of the same
     design system as the top bar and the controls section, instead of a bare strip. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#FF161616" />
    <corners
        android:topLeftRadius="20dp"
        android:bottomLeftRadius="20dp" />
    <stroke
        android:width="1dp"
        android:color="#1FFFFFFF" />
</shape>
