<?xml version="1.0" encoding="utf-8"?>
<!-- Landscape tool rail. Same surface as the controls section (#1A1A1A) with the same
     24dp rounding, so all three panels of the landscape editor share one design system.
     Rounded on the inner edge because it floats over the preview. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#FF1A1A1A" />
    <corners
        android:topLeftRadius="24dp"
        android:bottomLeftRadius="24dp" />
    <stroke
        android:width="1dp"
        android:color="#1FFFFFFF" />
</shape>
