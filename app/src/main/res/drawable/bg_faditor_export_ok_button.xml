<?xml version="1.0" encoding="utf-8"?>
<!-- Gold pill for the export dock's OK button (the Records one is blue-white). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/pro_check_gold" />
            <stroke
                android:width="1dp"
                android:color="#66C6A66A" />
            <corners android:radius="999dp" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="#FFF7E3B4"
                android:endColor="@color/pro_gold" />
            <stroke
                android:width="1dp"
                android:color="#66C6A66A" />
            <corners android:radius="999dp" />
        </shape>
    </item>
</selector>
