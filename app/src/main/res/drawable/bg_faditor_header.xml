<?xml version="1.0" encoding="utf-8"?>
<!-- Faditor header. Uses the Faded Night theme's card surface (a hair above pure black)
     so the bar reads as its own layer above the black preview. The bottom dock uses the
     same surface so the chrome stays one colour; champagne remains an accent on
     type/controls. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/amoled_card" />
    <corners
        android:bottomLeftRadius="24dp"
        android:bottomRightRadius="24dp" />
</shape>
