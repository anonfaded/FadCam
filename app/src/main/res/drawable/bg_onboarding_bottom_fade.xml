<?xml version="1.0" encoding="utf-8"?>
<!-- Full-width fade behind the floating dock: transparent at the top, black at the
     bottom, so cards dissolve into the navigation area instead of showing through. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:centerColor="#B8000000"
        android:endColor="#FF050505"
        android:startColor="#00000000" />
</shape>
