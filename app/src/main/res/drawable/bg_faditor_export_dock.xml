<?xml version="1.0" encoding="utf-8"?>
<!-- Export dock on the black Faditor header. Champagne accent, dark surface: the accent
     stays a highlight against black chrome instead of tinting the whole header. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#1F1A1308"
        android:centerColor="#2B1E1608"
        android:endColor="#3D241A06" />
    <stroke
        android:width="1dp"
        android:color="#40E8C77B" />
    <corners android:radius="18dp" />
    <padding
        android:left="14dp"
        android:top="14dp"
        android:right="14dp"
        android:bottom="14dp" />
</shape>
