<?xml version="1.0" encoding="utf-8"?>
<!-- Faditor uses the Pro screen's champagne accent, so its header dock is warm:
     the Records dock is blue-tinted and looked foreign on the gold screen. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#2B2A2317"
        android:centerColor="#3A241C0A"
        android:endColor="#50271C08" />
    <stroke
        android:width="1dp"
        android:color="#35E8C77B" />
    <corners android:radius="18dp" />
    <padding
        android:left="14dp"
        android:top="14dp"
        android:right="14dp"
        android:bottom="14dp" />
</shape>
