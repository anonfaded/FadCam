<?xml version="1.0" encoding="utf-8"?>
<!-- Agreement container: one premium charcoal panel holding both rows, with a
     thin muted champagne border. No glow, no corner brackets. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:endColor="#0D0D0C"
        android:startColor="#131312" />
    <corners android:radius="14dp" />
    <stroke
        android:width="1dp"
        android:color="@color/onboarding_card_stroke" />
</shape>
