<?xml version="1.0" encoding="utf-8"?>
<!-- A wide diagonal sheen instead of a centred glow: it brightens the upper-left like light
     falling across metal, with no visible edge anywhere. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:type="linear"
        android:angle="315"
        android:startColor="#2EF2C14E"
        android:centerColor="#0FF2C14E"
        android:endColor="#00F2C14E" />
</shape>
