<?xml version="1.0" encoding="utf-8"?>
<!-- Dossier-style header panel: app surface color with rounded bottom corners, matching the
     app's tab headers. Uses a fixed color because this activity runs on the stock Material
     theme where the app's colorTopBar attribute is not defined. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/dark_card_background" />
    <corners
        android:bottomLeftRadius="24dp"
        android:bottomRightRadius="24dp" />
</shape>
