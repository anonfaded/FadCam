<?xml version="1.0" encoding="utf-8"?>
<!-- Floating onboarding navigation dock. Nearly opaque charcoal so scrolling cards
     never read through the pill, with a thin muted champagne outline. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#FA0B0B0B" />
    <corners android:radius="28dp" />
    <stroke
        android:width="1dp"
        android:color="#3DC6A66A" />
</shape>
