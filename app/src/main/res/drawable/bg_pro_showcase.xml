<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/pro_surface" />
            <corners android:radius="20dp" />
            <stroke android:width="1dp" android:color="#59E8C77B" />
        </shape>
    </item>
    <!-- Stage light from above the phone: narrow wash that dies out by mid-height. -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="170dp"
                android:centerX="0.80"
                android:centerY="0.0"
                android:startColor="#1FE8C77B"
                android:endColor="#00E8C77B" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <!-- Floor pool: the golden stage floor the phone stands on. -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="120dp"
                android:centerX="0.80"
                android:centerY="0.98"
                android:startColor="#26E8C77B"
                android:endColor="#00E8C77B" />
            <corners android:radius="20dp" />
        </shape>
    </item>
</layer-list>
