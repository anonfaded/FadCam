<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Deep charcoal plate: solid, not a gradient. -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/pro_card_surface" />
            <corners android:radius="@dimen/pro_showcase_corner" />
            <stroke android:width="1dp" android:color="@color/pro_card_border" />
        </shape>
    </item>
    <!-- A barely perceptible warm wash where the light would fall, so the plate is not flat. -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="260dp"
                android:centerX="0.82"
                android:centerY="0.30"
                android:startColor="@color/pro_card_tint"
                android:endColor="#00C6A66A" />
            <corners android:radius="@dimen/pro_showcase_corner" />
        </shape>
    </item>
</layer-list>
