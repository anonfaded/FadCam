<?xml version="1.0" encoding="utf-8"?>
<!--
  Transparent row with a press ripple. Used for the action rows inside the asset detail
  sheet's single group card, so the card supplies the surface and the rows only react to
  touch — the same structure as the settings group cards.
-->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#33FFFFFF">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFFFF" />
        </shape>
    </item>
</ripple>
